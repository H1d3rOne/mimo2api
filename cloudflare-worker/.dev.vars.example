# 复制为 .dev.vars 用于 wrangler dev，本文件不要填真实值后提交。
# cp .dev.vars.example .dev.vars

MIMO2API_WS_URL="wss://your-worker-domain.example.com/ws"
MIMO_ENDPOINT_CONVERSION_ENABLED="false"

# AI API 鉴权；不设置则客户端调用不鉴权
# MIMO_RELAY_OPENAI_KEY="sk-your-random-secret"

# WebUI 登录；建议设置
# MIMO_WEBUI_USERNAME="admin"
# MIMO_WEBUI_PASSWORD="change-me"

# Worker 管理 MIMO AI Studio 用的 Tunnel/代理
# MIMO_PROXY_URL="https://your-tunnel-domain.example.com"
# MIMO_TUNNEL_TOKEN="your-cloudflare-tunnel-token"

# 可选
# MODEL_MAPPING_JSON='{"gpt-5.4-mini":"mimo-v2-flash"}'
