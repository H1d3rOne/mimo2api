# mimo2api Cloudflare Worker 版本配置
# 复制为 .env 或在系统环境变量中设置

# ============== Cloudflare Worker 网关地址 (必需) ==============
# 部署 Worker 后获得的公网地址
CF_WS_URL=wss://your-worker.your-subdomain.workers.dev/ws

# ============== MIMO API 凭证 (可选，优先级高于容器内环境变量) ==============
# 小米 AI Studio 的 API Key
MIMO_API_KEY=your-mimo-api-key

# MIMO API 端点
MIMO_API_ENDPOINT=https://api.mimo.ai/v1/chat/completions

# ============== 容器内环境变量 (如果上面未配置，bridge_cf.py 会读取这些) ==============
# 在 MIMO Claw 容器内设置的环境变量，用于 bridge_cf.py
# 如果在 manager_cf.py 中配置了 MIMO_API_KEY，这些会被自动注入
# CONTAINER_MIMO_API_KEY=your-mimo-api-key
# CONTAINER_MIMO_API_ENDPOINT=https://api.mimo.ai/v1/chat/completions
