# Cloudflare Worker 版本配置示例
# 复制为 .env 或在系统环境变量中设置

# ============== Cloudflare Worker 网关地址 ==============
# 部署 Worker 后获得的公网地址
WS_URL=wss://your-worker.your-subdomain.workers.dev/ws

# ============== MIMO API 凭证 ==============
# 小米 AI Studio 的 API Key
MIMO_API_KEY=your-mimo-api-key

# MIMO API 端点
MIMO_API_ENDPOINT=https://api.mimo.ai/v1/chat/completions

# ============== 用户标识 (可选) ==============
# 用于多账号场景下的节点标识
USER_ID=user_xxx
